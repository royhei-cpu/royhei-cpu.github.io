{
  "duration": 181.38702083333328,
  "voice": "Samantha",
  "speed": 1.0,
  "sampleRate": 48000,
  "listeningReview": "not_performed",
  "sourceRelease": "20261104-narrated-workshop",
  "cues": [
    {
      "scene": 0,
      "text": "Homecare now brings market research and product development into one workspace.",
      "start": 0.0,
      "end": 4.396375,
      "holdEnd": 4.576375
    },
    {
      "scene": 0,
      "text": "This guide covers the current website: browsing products, comparing national brands, and building a white-label proposal.",
      "start": 4.576375,
      "end": 11.6334375,
      "holdEnd": 12.0334375
    },
    {
      "scene": 1,
      "text": "Start with the main navigation.",
      "start": 12.0334375,
      "end": 13.765520833333333,
      "holdEnd": 13.945520833333333
    },
    {
      "scene": 1,
      "text": "Browse competitors, Global retailers and items, Sales and analysis, and White Label Workshop are the main working sections.",
      "start": 13.945520833333333,
      "end": 21.473458333333333,
      "holdEnd": 21.653458333333333
    },
    {
      "scene": 1,
      "text": "Brands and factories and Video guide are resources.",
      "start": 21.653458333333333,
      "end": 24.456145833333334,
      "holdEnd": 24.636145833333334
    },
    {
      "scene": 1,
      "text": "Opportunities comes last.",
      "start": 24.636145833333334,
      "end": 26.30260416666667,
      "holdEnd": 26.702604166666667
    },
    {
      "scene": 2,
      "text": "To find international products, open Global retailers and items.",
      "start": 26.702604166666667,
      "end": 30.754395833333334,
      "holdEnd": 30.934395833333333
    },
    {
      "scene": 2,
      "text": "Choose a Country or market, then a Retailer, and use Find an item to search.",
      "start": 30.934395833333333,
      "end": 35.379083333333334,
      "holdEnd": 35.559083333333334
    },
    {
      "scene": 2,
      "text": "For China, use the China listings shortcut.",
      "start": 35.559083333333334,
      "end": 38.35854166666667,
      "holdEnd": 38.53854166666667
    },
    {
      "scene": 2,
      "text": "Open Source listing to check the retailer's own page.",
      "start": 38.53854166666667,
      "end": 41.492375,
      "holdEnd": 41.892375
    },
    {
      "scene": 3,
      "text": "Use Select to compare on a global product card, or Select in the original catalog.",
      "start": 41.892375,
      "end": 46.621770833333336,
      "holdEnd": 46.801770833333336
    },
    {
      "scene": 3,
      "text": "Compare selected opens your shortlist.",
      "start": 46.801770833333336,
      "end": 48.90291666666667,
      "holdEnd": 49.08291666666667
    },
    {
      "scene": 3,
      "text": "Export selected CSV downloads the selected records for Excel.",
      "start": 49.08291666666667,
      "end": 53.003750000000004,
      "holdEnd": 53.18375
    },
    {
      "scene": 3,
      "text": "Product photos are exported as links, rather than embedded pictures.",
      "start": 53.18375,
      "end": 57.07114583333334,
      "holdEnd": 57.47114583333334
    },
    {
      "scene": 4,
      "text": "Sales and analysis shows the saved evidence.",
      "start": 57.47114583333334,
      "end": 60.051437500000006,
      "holdEnd": 60.231437500000006
    },
    {
      "scene": 4,
      "text": "Compare sales figures only when the retailer, metric, reporting period, and snapshot date match.",
      "start": 60.231437500000006,
      "end": 66.29158333333334,
      "holdEnd": 66.47158333333334
    },
    {
      "scene": 4,
      "text": "Missing sales information stays unknown.",
      "start": 66.47158333333334,
      "end": 68.75141666666667,
      "holdEnd": 68.93141666666668
    },
    {
      "scene": 4,
      "text": "Research coverage is not market share.",
      "start": 68.93141666666668,
      "end": 71.09818750000001,
      "holdEnd": 71.49818750000001
    },
    {
      "scene": 5,
      "text": "White Label Workshop opens a dedicated workshop page.",
      "start": 71.49818750000001,
      "end": 74.83243750000001,
      "holdEnd": 75.01243750000002
    },
    {
      "scene": 5,
      "text": "Choose a Home-care subcategory and a Product concept.",
      "start": 75.01243750000002,
      "end": 77.97104166666668,
      "holdEnd": 78.15104166666669
    },
    {
      "scene": 5,
      "text": "Explore laundry, storage, waste, odor control, and accessories.",
      "start": 78.15104166666669,
      "end": 82.88452083333335,
      "holdEnd": 83.06452083333336
    },
    {
      "scene": 5,
      "text": "Follow the three review steps: Real products, Why and what changes, then Design and costs.",
      "start": 83.06452083333335,
      "end": 89.03352083333334,
      "holdEnd": 89.43352083333335
    },
    {
      "scene": 6,
      "text": "Start with National-brand photo references.",
      "start": 89.43352083333335,
      "end": 91.87381250000001,
      "holdEnd": 92.05381250000002
    },
    {
      "scene": 6,
      "text": "The laundry sorter uses Joseph Joseph and Brabantia.",
      "start": 92.05381250000002,
      "end": 95.15414583333336,
      "holdEnd": 95.33414583333337
    },
    {
      "scene": 6,
      "text": "Choose View full-size photo to inspect the image.",
      "start": 95.33414583333335,
      "end": 98.07216666666669,
      "holdEnd": 98.2521666666667
    },
    {
      "scene": 6,
      "text": "Read its match note, Size and capacity, Manufacturer data, and Photo source before comparing.",
      "start": 98.25216666666668,
      "end": 104.52864583333334,
      "holdEnd": 104.92864583333335
    },
    {
      "scene": 7,
      "text": "Next, open Why and what changes.",
      "start": 104.92864583333335,
      "end": 107.25768750000002,
      "holdEnd": 107.43768750000002
    },
    {
      "scene": 7,
      "text": "Read Why consider white label, then expand Brand reference and proof needed.",
      "start": 107.43768750000001,
      "end": 111.56627083333335,
      "holdEnd": 111.74627083333336
    },
    {
      "scene": 7,
      "text": "Suggested changes also compares existing features, proposed improvements, and validation.",
      "start": 111.74627083333334,
      "end": 117.5076875,
      "holdEnd": 117.68768750000001
    },
    {
      "scene": 7,
      "text": "These ideas still need a Target assortment check.",
      "start": 117.68768750000001,
      "end": 120.29816666666667,
      "holdEnd": 120.69816666666668
    },
    {
      "scene": 8,
      "text": "Continue to Design and costs for the proposed Blender concept.",
      "start": 120.69816666666668,
      "end": 124.09962500000002,
      "holdEnd": 124.27962500000002
    },
    {
      "scene": 8,
      "text": "Use Specs and dimensions to switch between millimetres and inches.",
      "start": 124.27962500000001,
      "end": 127.73191666666668,
      "holdEnd": 127.91191666666668
    },
    {
      "scene": 8,
      "text": "Choose a finish to update the interactive model.",
      "start": 127.91191666666667,
      "end": 130.44095833333333,
      "holdEnd": 130.62095833333333
    },
    {
      "scene": 8,
      "text": "Use Studio, Front, or Exploded.",
      "start": 130.62095833333333,
      "end": 133.15597916666667,
      "holdEnd": 133.33597916666668
    },
    {
      "scene": 8,
      "text": "The rebuilt laundry sorter also has Inside and Details views.",
      "start": 133.33597916666668,
      "end": 136.81943750000002,
      "holdEnd": 137.21943750000003
    },
    {
      "scene": 9,
      "text": "BOM and pricing lets you adjust component costs and assumptions.",
      "start": 137.2194375,
      "end": 140.8,
      "holdEnd": 140.98000000000002
    },
    {
      "scene": 9,
      "text": "Enter a duty rate before calculating landed cost.",
      "start": 140.98,
      "end": 144.0184583333333,
      "holdEnd": 144.19845833333332
    },
    {
      "scene": 9,
      "text": "Costs and proposed retail prices are planning estimates, not supplier quotes.",
      "start": 144.19845833333332,
      "end": 148.95829166666664,
      "holdEnd": 149.35829166666664
    },
    {
      "scene": 10,
      "text": "Download the Blender development pack for the base Sage model, renders, dimensions, specifications, and BOM.",
      "start": 149.35829166666664,
      "end": 156.42460416666665,
      "holdEnd": 156.60460416666666
    },
    {
      "scene": 10,
      "text": "Save brief with comparison photos keeps your selected finish and pricing edits in an HTML brief.",
      "start": 156.60460416666663,
      "end": 162.29635416666665,
      "holdEnd": 162.47635416666665
    },
    {
      "scene": 10,
      "text": "Export references and changes saves a source-linked CSV.",
      "start": 162.47635416666662,
      "end": 165.9792291666666,
      "holdEnd": 166.15922916666662
    },
    {
      "scene": 10,
      "text": "Review Validation before proceeding.",
      "start": 166.15922916666662,
      "end": 168.2563333333333,
      "holdEnd": 168.6563333333333
    },
    {
      "scene": 11,
      "text": "Use Opportunities last to investigate possible gaps after reviewing the products and evidence.",
      "start": 168.6563333333333,
      "end": 173.91979166666664,
      "holdEnd": 174.09979166666665
    },
    {
      "scene": 11,
      "text": "Music and button sounds have separate controls.",
      "start": 174.09979166666662,
      "end": 176.66987499999996,
      "holdEnd": 176.84987499999997
    },
    {
      "scene": 11,
      "text": "You can keep the workspace quiet while you browse, compare, and develop.",
      "start": 176.84987499999994,
      "end": 180.98702083333328,
      "holdEnd": 181.38702083333328
    }
  ]
}